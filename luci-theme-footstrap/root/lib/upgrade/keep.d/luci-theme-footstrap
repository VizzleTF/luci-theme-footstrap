# Preserve the two admin-uploaded images across sysupgrade: the login/page background
# (Appearance -> Wallpaper -> File) and the wallpaper pattern (Appearance -> Wallpaper ->
# Pattern). Both are written at runtime through cgi-upload, so neither is a package file
# and both survive a package upgrade on their own; a firmware sysupgrade, however, only
# keeps paths listed here (or in a conffile / /etc/sysupgrade.conf).
# NOT a conffile: it lives outside root/etc/config, and tools/conffiles.mjs would reject
# a conffiles-define entry the package does not ship.
/etc/footstrap/login-bg
/etc/footstrap/pattern.svg

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Edit(**/cascade.css)",
      "Edit(tmp/**)",
      "Edit(**/docs/screenshots/**)"
    ],
    "additionalDirectories": [
      "../tmp"
    ],
    "ask": [
      "Bash(npm run live:*)",
      "Bash(luci-theme-footstrap/dev-sync.sh:*)",
      "Bash(./luci-theme-footstrap/dev-sync.sh:*)",
      "Bash(ssh:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)",
      "Bash(git push --follow-tags:*)",
      "Bash(git push origin --follow-tags:*)",
      "Bash(git push origin v*)",
      "Bash(git push origin refs/tags/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(gh release:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh api * -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api * --field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api * --input*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run changelog:*)",
      "Bash(npm run computed-diff:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm run makefile-contract:*)",
      "Bash(node tools/*)",
      "Bash(node .claude/tooling/*)",
      "Bash(sh -n *)",
      "Bash(md5sum:*)",
      "Bash(tools/bg.sh:*)",
      "Bash(tools/bg-wait.sh:*)",
      "Bash(./tools/stage.sh:*)",
      "Bash(owfeed build:*)",
      "Bash(owlab up:*)",
      "Bash(owlab down:*)",
      "Bash(owlab sync:*)",
      "Bash(owlab test:*)",
      "Bash(owlab exec:*)",
      "Bash(owlab status:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec owlab-*)",
      "Read(../tmp/**)",
      "Write(../tmp/**)",
      "Edit(../tmp/**)",
      "Bash(git commit:*)",
      "Bash(git push origin:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-list:*)",
      "Bash(git reflog:*)",
      "Bash(git worktree list:*)",
      "Bash(git merge-base:*)",
      "Bash(gh api repos/*/actions/*)",
      "Bash(gh api repos/*/pulls/*)",
      "Bash(gh api repos/*/issues/*)",
      "Bash(gh api repos/*/commits/*)",
      "Bash(gh api repos/*/rulesets*)",
      "Bash(gh run list:*)",
      "Bash(tools/ci-watch.sh:*)",
      "Bash(tools/ci-log.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.sh\"",
            "statusMessage": "Checking git authorization"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit-gate.sh\"",
            "statusMessage": "Checking the changelog contract"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "developer|tester|security|researcher|upstream-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-start.sh\""
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/permission-denied.sh\""
          }
        ]
      }
    ]
  }
}

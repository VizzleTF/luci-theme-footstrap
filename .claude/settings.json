{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "300000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Edit(**/cascade.css)",
      "Edit(tmp/**)",
      "Edit(**/docs/screenshots/**)"
    ],
    "additionalDirectories": [
      "../tmp"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm run live:*)",
      "Bash(luci-theme-footstrap/dev-sync.sh:*)",
      "Bash(./luci-theme-footstrap/dev-sync.sh:*)",
      "Bash(ssh:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(gh api:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run changelog:*)",
      "Bash(npm run computed-diff:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm run makefile-contract:*)",
      "Bash(node tools/*)",
      "Bash(node .claude/tooling/*)",
      "Bash(ucode -T -c *)",
      "Bash(sh -n *)",
      "Bash(md5sum:*)",
      "Bash(tools/bg.sh:*)",
      "Bash(tools/bg-wait.sh:*)",
      "Bash(./tools/stage.sh:*)",
      "Bash(owfeed build:*)",
      "Bash(owlab up:*)",
      "Bash(owlab down:*)",
      "Bash(owlab sync:*)",
      "Bash(owlab test:*)",
      "Bash(owlab exec:*)",
      "Bash(owlab status:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec owlab-*)",
      "Read(../tmp/**)",
      "Write(../tmp/**)",
      "Edit(../tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit-gate.sh",
            "statusMessage": "Checking the changelog contract"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

# No dev dependency's install script runs, in CI or on a developer's machine: package-lock.json
# carries no hasInstallScript and package.json no pre/post/prepare hook, so nothing here needs one.
ignore-scripts=true
# npm ci asks the registry for nothing but the tarballs: no audit report (Dependabot watches the
# lock), no funding notice and no check for a newer npm (it printed `npm notice` under sudo npx).
audit=false
fund=false
update-notifier=false

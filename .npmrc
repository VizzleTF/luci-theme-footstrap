# No dev dependency's install script runs, in CI or on a developer's machine: package-lock.json
# carries no hasInstallScript and package.json no pre/post/prepare hook, so nothing here needs one.
ignore-scripts=true
# No min-release-age: npm 11.20 loops forever installing a fresh version with a peer cycle
# (eslint 10.13.0, 7124 placeDep rounds, card 0183); Dependabot's cooldown holds the age instead.

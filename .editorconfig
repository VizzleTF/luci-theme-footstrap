# Indentation and line endings, for editors that read this before eslint/stylelint can say anything.
# The gates own everything else: `npm run lint` is the authority on JS and CSS style.
#
# Tabs are the tree's indent, including the shell that ends up in the package: strip-shell.sh and
# strip-templates.sh rewrite those files line by line, and a mixed indent shows up as a diff nobody
# meant to make.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

# npm rewrites both on every install and uses two spaces; matching it keeps the diff to what changed.
[{package.json,package-lock.json}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces = a line break) and the tables in
# docs/ are aligned with spaces.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Generated by gettext tooling; leave its formatting alone.
[*.{po,pot}]
indent_style = space
trim_trailing_whitespace = false

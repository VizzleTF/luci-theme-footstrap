# build artifacts
*.apk
*.ipk
/bin/
# generated by luci-theme-footstrap/build-css.sh from the styles/ tree
/luci-theme-footstrap/htdocs/luci-static/footstrap/cascade.css
# generated by tools/devkit-build.mjs from devkit.src.html + gallery.html + 02-tokens.css (built in CI for Pages)
/docs/devkit.html
# editor
.vscode/
.idea/
*.swp
# macOS finder droppings — one had already been committed under docs/
.DS_Store
# page review screenshots
page-review/
# built packages
dist/

# lint/a11y tooling only — never shipped (see package.json).
# package-lock.json IS committed on purpose: it pins the transitive dependency
# tree, so CI lints with exactly what was verified here.
node_modules/

# python bytecode from the audit tooling
__pycache__/
# local overrides for the dev-router containers (public key path, DNS) — machine-specific
/docker/.env
# built by docker/hwsim-up.sh for the WSL host kernel; not portable, not source
/docker/hwsim/*.ko

# written by tools/stage-release.sh in the release job — the release BODY, not an asset
release-notes.md

# personal Claude Code state: skills pulled by `npx skills add` (a symlink into .agents/), the
# installer's lock and the per-machine settings override; the playwright venv beside tools/probes/
/.agents/
/.claude/skills/
/skills-lock.json
/.claude/settings.local.json
/tools/probes/preview-venv/

# EnterWorktree checkouts: a second copy of every file, so grep and eslint report each hit twice
/.claude/worktrees/

# build artifacts
*.apk
*.ipk
/bin/
# generated by luci-theme-footstrap/build-css.sh from the styles/ tree
/luci-theme-footstrap/htdocs/luci-static/footstrap/cascade.css
# generated by tools/devkit-build.mjs from devkit.src.html + gallery.html + 02-tokens.css (built in CI for Pages)
/docs/devkit.html
# editor
.vscode/
.idea/
*.swp
# macOS finder droppings — one had already been committed under docs/
.DS_Store
# built packages
dist/

# build and e2e tooling only — never shipped (see package.json).
# package-lock.json IS committed on purpose: it pins the transitive dependency
# tree, so CI builds and tests with exactly what was verified here.
node_modules/

# python bytecode (docs/screenshots/capture.py)
__pycache__/

# written by tools/stage-release.sh in the release job — the release BODY, not an asset
release-notes.md

# personal Claude Code state: the per-machine settings override
/.claude/settings.local.json

# EnterWorktree checkouts: a second copy of every file, so grep reports each hit twice
/.claude/worktrees/
